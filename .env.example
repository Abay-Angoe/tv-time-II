# Copy to .env and fill in. .env is gitignored.

# TMDB — required for enrichment. Free key: https://www.themoviedb.org/settings/api
# Either the v3 API key or a v4 read access token works; the client detects which.
TMDB_API_KEY=

# Gemini — required only if config.toml [labeling] provider = "gemini".
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional alternates for cluster labeling if you switch [labeling] provider.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
